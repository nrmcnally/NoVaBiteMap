# Copy with: Copy-Item .env.example .env
# NWS asks API clients to identify themselves with a real contact address.
NWS_USER_AGENT=BiteMap-NOVA/0.1 (contact: you@example.com)

# Run FastAPI independently with SQLite by leaving this value as shown.
DATABASE_URL=sqlite:///./bitemap.db
REDIS_URL=redis://localhost:6379/0
REQUEST_TIMEOUT_SECONDS=10
SESSION_HOURS=168
API_BASE_URL=http://localhost:8000

