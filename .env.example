# Copy with: Copy-Item .env.example .env
# NWS asks API clients to identify themselves with a real contact address.
NWS_USER_AGENT=BiteMap-NOVA/0.2 (contact: you@example.com)

# --- Database ---------------------------------------------------------------
# Local/dev + tests use SQLite with zero dependencies (auto-creates + auto-seeds).
# The composed stack overrides this with PostgreSQL/PostGIS (see docker-compose.yml).
DATABASE_URL=sqlite:///./bitemap.db

# --- Cache (optional) -------------------------------------------------------
# Redis is optional. Leave REDIS_URL unset to use the in-process TTL cache
# (graceful degradation). The composed stack sets redis://redis:6379/0.
REDIS_URL=
CACHE_TTL_SECONDS=900

# --- Providers / API --------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10
SESSION_HOURS=168

# Hosted Sites uses D1 for email/password accounts. Docker Compose overrides
# this to `api`, backed by FastAPI/PostgreSQL. Both keep the session token inside
# an HTTP-only web cookie.
# For `npm run dev`, start the server once and run `npm run db:local:apply` to
# apply the generated Drizzle migrations to the local Miniflare D1 database.
BITEMAP_ACCOUNT_BACKEND=d1

# Base URL the Next.js frontend uses to reach the canonical FastAPI backend.
API_BASE_URL=http://localhost:8000
# Comma-separated CORS allowlist for the API (frontend origins).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated admin allowlist. Gates the web /admin/data-health page AND the
# API's POST /admin/ingestion/reseed route. Fails closed: when unset, NO account
# is an admin, so reseed is denied to everyone (set your own email to enable it).
BITEMAP_ADMIN_EMAILS=

# Docker Compose only. Change this before exposing a self-hosted instance.
POSTGRES_PASSWORD=replace-with-a-long-random-password
