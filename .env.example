# Copy with: Copy-Item .env.example .env
# NWS asks API clients to identify themselves with a real contact address.
NWS_USER_AGENT=BiteMap-NOVA/0.2 (contact: you@example.com)

# --- Database ---------------------------------------------------------------
# Local/dev + tests use SQLite with zero dependencies (auto-creates + auto-seeds).
# The composed stack overrides this with PostgreSQL/PostGIS (see docker-compose.yml).
DATABASE_URL=sqlite:///./bitemap.db

# --- Cache (optional) -------------------------------------------------------
# Redis is optional. Leave REDIS_URL unset to use the in-process TTL cache
# (graceful degradation). The composed stack sets redis://redis:6379/0.
REDIS_URL=
CACHE_TTL_SECONDS=900

# --- Providers / API --------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=10
SESSION_HOURS=168

# Base URL the Next.js frontend uses to reach the canonical FastAPI backend.
API_BASE_URL=http://localhost:8000
# Comma-separated CORS allowlist for the API (frontend origins).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional comma-separated allowlist for /admin/data-health.
# The deployed owner-only site remains the outer access boundary when unset.
BITEMAP_ADMIN_EMAILS=
