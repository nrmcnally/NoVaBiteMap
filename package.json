{
  "name": "bitemap-nova",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "audit:evidence": "tsx scripts/apply-evidence-verdicts.mts --check",
    "audit:seed": "tsx scripts/check-seed-parity.mts",
    "audit:review": "tsx scripts/build-fish-community-review.mts --check",
    "audit:guide": "tsx scripts/check-fish-guide.mts",
    "audit:species-research": "node scripts/run-species-research-pipeline.mjs --check",
    "audit:model-review": "node scripts/run-model-review-audit.mjs --check",
    "audit:candidate-models": "node scripts/run-candidate-model-fixtures.mjs --check",
    "audit:candidate-validation": "node scripts/run-candidate-validation-gate.mjs --check",
    "test:replay": "tsx --test tests/historical-replay.test.ts",
    "test:timeline": "tsx --test tests/prediction-timeline.test.ts tests/timeline-score-matrix.test.ts",
    "test:hydrology": "tsx --test tests/hydrology-graph.test.ts",
    "test": "npm run audit:evidence && npm run audit:seed && npm run audit:review && npm run audit:guide && npm run test:replay && npm run test:timeline && npm run test:hydrology && npm run build && node --test tests/rendered-html.test.mjs tests/advisories.test.mjs",
    "test:api": "python -m pytest apps/api/tests -q",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .pytest_cache --ignore-pattern apps/api/.pytest_cache",
    "db:generate": "drizzle-kit generate",
    "db:local:apply": "node scripts/apply-local-d1-migrations.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
